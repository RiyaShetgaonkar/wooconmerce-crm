# Copy to backend/.env and fill in your values.
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=woocommerce_crm
DB_CONNECTION_LIMIT=10

# Customer segmentation
SEGMENT_HIGH_VALUE_SPEND=500
SEGMENT_REPEAT_ORDERS=2

# Follow-up suggestion triggers
FOLLOWUP_UNRESOLVED_HOURS=24
FOLLOWUP_CONTACT_GAP_DAYS=30
FOLLOWUP_LAPSED_DAYS=60

# WooCommerce REST API (WooCommerce > Settings > Advanced > REST API)
WC_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx
# Optional: auto-sync every N minutes
WC_SYNC_INTERVAL_MINUTES=
